<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:partial="clr-namespace:WorldolioMauiPOC.Views.Partial"
             x:Class="WorldolioMauiPOC.Views.Plan"
             Title="Time Planner">

    <Grid   
            Padding="5"  
            ColumnDefinitions="Auto, *, Auto"  
            RowDefinitions="Auto, Auto, Auto, Auto, Auto">

        <partial:TabBar 
            x:Name="TabBarButtons"
        />

        <Label 
            Grid.Column="1"
            Text="Planning View"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <Label
            Grid.Column="1"
            Grid.Row="1"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            >
            <Label.FormattedText>
                <FormattedString>
                    <Span Text="Time: " TextColor="Gray" />
                    <Span Text="{Binding CurrentTime}" FontAttributes="Bold" />
                </FormattedString>
            </Label.FormattedText>
        </Label>

        <ImageButton 
            Grid.Row="2" 
            HorizontalOptions="Center" 
            VerticalOptions="Center" 
            HeightRequest="40" 
            WidthRequest="40"
            Clicked="Left_Clicked"
            >
            <ImageButton.Source>
                <FontImageSource  
                    Glyph="&#xe5c4;"
                    FontFamily="MaterialSymbolsOutlined" 
                    Color="{AppThemeBinding Light={StaticResource OffBlack},
                                            Dark={StaticResource White}}"
                    Size="20"/>
            </ImageButton.Source>
        </ImageButton>

        <Slider
            Grid.Column="1"
            Grid.Row="2"
            x:Name="TimeSlider"
            VerticalOptions="Center" 
            Minimum="0"
            Maximum="95"
            Value="48"
            ValueChanged="Slider_ValueChanged" />

        <ImageButton 
            Grid.Column="2"
            Grid.Row="2" 
            HorizontalOptions="Center" 
            VerticalOptions="Center" 
            HeightRequest="40" 
            WidthRequest="40"
            Clicked="Right_Clicked"
            >
            <ImageButton.Source>
                <FontImageSource  
                    Glyph="&#xe5c8;"
                    FontFamily="MaterialSymbolsOutlined" 
                    Color="{AppThemeBinding Light={StaticResource OffBlack},
                                            Dark={StaticResource White}}"
                    Size="20"/>
            </ImageButton.Source>
        </ImageButton>

    </Grid>

</ContentPage>