<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorldolioMauiPOC.Views.CityGrid"
             Title="CityGrid">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Settings"
                     Order="Secondary"
                     Priority="1"
                     Clicked="Toolbar_Settings"
                     >
        </ToolbarItem>
        <ToolbarItem Text="About"
                     Order="Secondary"
                     Priority="2"
                     Clicked="Toolbar_About"
                     >
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    
    <Grid RowDefinitions="auto,*">
        <Label Grid.Row="1">
            <Label.FormattedText>
                <FormattedString>
                    <Span Text="Version: " TextColor="Gray" />
                    <Span Text="{Binding AppVersion}" FontAttributes="Bold" />
                </FormattedString>
            </Label.FormattedText>
        </Label>
        <CollectionView 
                x:Name="citiesCollection"
                Grid.Row="2"
                ItemsSource="{Binding Cities}"
                Margin="10"
                SelectionMode="Single"
                SelectionChanged="citiesCollection_SelectionChanged"
                >
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="20" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout>
                        <HorizontalStackLayout>
                            <Label Text="{Binding DisplayName}" FontSize="Default" FontAttributes="Bold" />
                            <Label Text="{Binding Country.DisplayName}" FontSize="Default" Margin="40,4,0,0" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>