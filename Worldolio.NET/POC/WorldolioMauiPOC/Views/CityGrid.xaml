<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="WorldolioMauiPOC.Views.CityGrid"
             x:Name="thisPage"
             xmlns:viewModels="clr-namespace:WorldolioMauiPOC.ViewModels.CityGrid"
             Title="Worldolio">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing" Command="{Binding InitCommand}" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="auto,*">
        <Label
            Padding="5"  
            >
            <Label.FormattedText>
                <FormattedString>
                    <Span Text=" Time: " TextColor="Gray" />
                    <Span Text="{Binding CurrentTime}" FontAttributes="Bold" />
                    <Span Text=" " TextColor="Gray" />
                    <Span Text="{Binding NumberOfCities}"/>
                    <Span Text=" cities" TextColor="Gray" />
                    <Span Text=" Moon: " TextColor="Gray" />
                    <Span Text="{Binding MoonPhase}" />
                </FormattedString>
            </Label.FormattedText>
        </Label>
        <CollectionView 
                x:Name="citiesCollection"
                Grid.Row="1"
                ItemsSource="{Binding Cities}"
                Margin="5"
                SelectionMode="Single"
                SelectionChanged="citiesCollection_SelectionChanged"
                >
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame 
                        Style="{StaticResource Frame.DataTemplate}"
                        >
                        <Grid   
                            Padding="5"  
                            ColumnDefinitions="Auto, *"  
                            RowDefinitions="Auto, Auto, Auto, Auto, Auto">

                            <!--
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer 
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewModels:CityGridViewModel}}, Path=ItemTappedCommand}"
                                    CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>
                            -->

                            <!-- 
                            this can aparently sometimes get the wrong item parameter, so we may need to use TapGestureRecognizer 
                            this does block the item selected - which is what we want anyway
                            -->
                            <Grid.Behaviors>
                                <toolkit:TouchBehavior 
                                    DefaultBackgroundColor="{StaticResource White}"
                                    PressedBackgroundColor="{StaticResource PrimaryLight}"
                                    Command="{Binding BindingContext.ItemTappedCommand,Source={x:Reference thisPage}}"
                                    CommandParameter="{Binding .}"
                                />
                            </Grid.Behaviors>

                            <Label  
                                Style="{StaticResource Label.BigGridItem}"
                                HorizontalTextAlignment="Center"
                                Text="{Binding CurrentDay}" />

                            <Label  
                                Style="{StaticResource Label.BigGridItem}"
                                Grid.Column="1"
                                Text="{Binding CurrentTime}" />

                            <Label
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Style="{StaticResource Label.LittleGridItem}"
                                >
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding CityName}" FontAttributes="Bold" />
                                        <Span Text=", "/>
                                        <Span Text="{Binding CountryName}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <Label
                                Grid.Row="2"
                                Grid.ColumnSpan="2"
                                Style="{StaticResource Label.LittleGridItem}"
                                >
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding OffsetToHome}" FontAttributes="Bold" />
                                        <Span Text=" DST: "/>
                                        <Span Text="{Binding DSTDates}" FontAttributes="Bold" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <Label
                                Grid.Row="3"
                                Grid.ColumnSpan="2"
                                Style="{StaticResource Label.LittleGridItem}"
                                >
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Sun Rise: "/>
                                        <Span Text="{Binding Sunrise}" FontAttributes="Bold" />
                                        <Span Text=", Noon: "/>
                                        <Span Text="{Binding Noon}" FontAttributes="Bold" />
                                        <Span Text=", Set: "/>
                                        <Span Text="{Binding Sunset}" FontAttributes="Bold" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>

                            <Label
                                Grid.Row="4"
                                Grid.ColumnSpan="2"
                                Style="{StaticResource Label.LittleGridItem}"
                                >
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Moon Rise: "/>
                                        <Span Text="{Binding Moonrise}" FontAttributes="Bold" />
                                        <Span Text=", Set: "/>
                                        <Span Text="{Binding Moonset}" FontAttributes="Bold" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>