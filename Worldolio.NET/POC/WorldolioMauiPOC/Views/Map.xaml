<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:drawableControls="clr-namespace:WorldolioMauiPOC.Views.Drawable"
             x:Class="WorldolioMauiPOC.Views.Map"
             Title="Map">

    <ScrollView>

        <Grid   
            Padding="10"
            RowSpacing="5"
            ColumnDefinitions="*"
            RowDefinitions="Auto, Auto"
            SizeChanged="Grid_SizeChanged"
            >

            <Label 
                x:Name="MapTooltipLabel"
                Text="  "
                VerticalOptions="Center" 
                HorizontalOptions="Center" />

            <GraphicsView 
                Grid.Row="1"
                x:Name="MapGraphicsView"
                HorizontalOptions="Fill"
                MoveHoverInteraction="MapGraphicsView_MoveHoverInteraction"
                EndHoverInteraction="MapGraphicsView_EndHoverInteraction"
                EndInteraction="MapGraphicsView_EndInteraction"
                >
                <GraphicsView.GestureRecognizers>
                    <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="TapGestureRecognizer_Tapped" />
                </GraphicsView.GestureRecognizers>
            </GraphicsView>
                

        </Grid>

    </ScrollView>

</ContentPage>