<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:drawableControls="clr-namespace:WorldolioMauiPOC.Views.Drawable"
             x:Class="WorldolioMauiPOC.Views.Map"
             Title="Map">

    <ScrollView>

        <Grid   
            Padding="10"
            RowSpacing="5"
            ColumnDefinitions="*"
            RowDefinitions="Auto"
            SizeChanged="Grid_SizeChanged"
            >

            <GraphicsView 
                x:Name="MapGraphicsView"
                HorizontalOptions="Fill"
                />
            
        </Grid>

    </ScrollView>

</ContentPage>