<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorldolioMauiPOC.Views.CityList"
             Title="CityList">

    <CollectionView x:Name="citiesCollection"
                ItemsSource="{Binding Cities}"
                Margin="10"
                SelectionMode="Single"
                SelectionChanged="citiesCollection_SelectionChanged"
                >
        <CollectionView.ItemsLayout>
            <LinearItemsLayout Orientation="Vertical" ItemSpacing="20" />
        </CollectionView.ItemsLayout>

        <CollectionView.ItemTemplate>
            <DataTemplate>
                <VerticalStackLayout>
                    <HorizontalStackLayout>
                        <Label Text="{Binding DisplayName}" FontSize="Default" FontAttributes="Bold" />
                        <Label Text="{Binding Country.DisplayName}" FontSize="Default" Margin="40,4,0,0" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>